{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "batch-link-opener",
  "compatibility_date": "2026-09-01",
  // Publish on <name>.<subdomain>.workers.dev; add a "routes" entry for a custom domain.
  "workers_dev": true,
  // Static assets only — there is no Worker script, because the whole batch
  // lives in the URL fragment and never reaches the server.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
